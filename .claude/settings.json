{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-check.sh\"",
            "timeout": 30,
            "statusMessage": "Running ruff check..."
          }
        ]
      }
    ]
  }
}
